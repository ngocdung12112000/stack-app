        },
        {
          "name": "Correct password, still locked (423)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 423', () => pm.response.to.have.status(423));",
                  "pm.test('code = IDENTITY_LOCKED_OUT', () => pm.expect(pm.response.json().code).to.eql('IDENTITY_LOCKED_OUT'));"
                ]
              }
            }
          ]
        }
      ]
    },
